generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String           @id @default(uuid())
  googleId        String           @unique
  name            String
  email           String           @unique
  avatar          String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  campaigns       Campaign[]
  senders         Sender[]
  slackConnection SlackConnection?

  @@map("users")
}

model SlackConnection {
  id          String   @id @default(uuid())
  userId      String   @unique
  accessToken String
  teamId      String?
  teamName    String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("slack_connections")
}

model Sender {
  id           String           @id @default(uuid())
  userId       String
  name         String
  smtpEmail    String
  smtpHost     String
  smtpPort     Int
  smtpUser     String
  smtpPassword String
  createdAt    DateTime         @default(now())
  emails       ScheduledEmail[]
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("senders")
}

model Campaign {
  id                 String         @id @default(uuid())
  userId             String
  subject            String
  body               String
  startTime          DateTime
  delayBetweenEmails Int
  hourlyLimit        Int
  status             CampaignStatus @default(ACTIVE)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails ScheduledEmail[]
  leads  Lead[]

  @@map("campaigns")
}

model ScheduledEmail {
  id             String      @id @default(uuid())
  campaignId     String
  senderId       String
  recipientEmail String
  scheduledAt    DateTime
  status         EmailStatus @default(SCHEDULED)
  bullmqJobId    String?
  messageId      String?
  sentAt         DateTime?
  errorMessage   String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  campaign       Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sender         Sender      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([scheduledAt])
  @@index([recipientEmail])
  @@map("scheduled_emails")
}

enum EmailStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
}

enum CampaignStatus {
  ACTIVE
  COMPLETED
  PAUSED
}

model Lead {
  id         String   @id @default(uuid())
  campaignId String
  email      String
  firstName  String?
  company    String?
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id])
}
