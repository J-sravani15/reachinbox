# Base URL for the ReachInbox backend API.
VITE_API_URL=http://localhost:5000/api

# The user id campaigns are created under. The backend enforces a foreign key to
# the users table, so set this to a real user id from your database (e.g. the id
# of the Google-account user in `users`). If left empty, the app will try to
# infer it from the most recent existing campaign before creating a new one.
VITE_USER_ID=